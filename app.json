{
  "expo": {
    "name": "FindBack",
    "slug": "findback",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/findback-icon.png",
    "scheme": "findback",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.morningcoffeelabs.findback",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FindBack uses your location to save the place you want to return to.",
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "android": {
      "package": "com.morningcoffeelabs.findback",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0866E8",
        "foregroundImage": "./assets/images/findback-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/findback-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FindBack uses your location to save the place you want to return to."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/findback-pin.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0866E8",
          "dark": {
            "backgroundColor": "#0866E8"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "en": "./locales/en.json",
      "nb": "./locales/nb.json",
      "sv": "./locales/sv.json",
      "da": "./locales/da.json",
      "de": "./locales/de.json",
      "pl": "./locales/pl.json",
      "es": "./locales/es.json",
      "pt": "./locales/pt.json"
    }
  }
}
